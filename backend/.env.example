# --- Django ---
APP_NAME=KARTIKA Intel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Ganti di produksi. Buat nilai acak: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite untuk MVP. Untuk PostgreSQL:
# DATABASE_URL=postgresql://satria:satria@localhost:5432/kartika_intel
DATABASE_URL=sqlite:///./kartika_intel.db

# Origin frontend saat mode `npm run dev` (dipisah koma).
# Mode satu server (manage.py runserver) tidak membutuhkan CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Batas pengambilan artikel
FETCH_TIMEOUT_SECONDS=15
MAX_CONTENT_CHARS=60000

# Ambang analisis koordinasi
COORDINATION_SIMILARITY_THRESHOLD=0.28
COORDINATION_WINDOW_HOURS=72
COORDINATION_MIN_CORPUS=3

# Pemeriksaan fakta eksternal (Google Fact Check Tools API).
# Aktifkan "Fact Check Tools API" di Google Cloud Console lalu tempel API key di sini.
FACTCHECK_ENABLED=true
GOOGLE_FACTCHECK_API_KEY=
FACTCHECK_TIMEOUT_SECONDS=6
FACTCHECK_MAX_QUERIES=2
FACTCHECK_PAGE_SIZE=5
FACTCHECK_CACHE_TTL_HOURS=168
FACTCHECK_MIN_OVERLAP=0.45
# Kosongkan agar pencarian tidak dibatasi bahasa ulasan.
FACTCHECK_LANGUAGE_CODE=

# --- Verifikasi klaim berbasis AI (opsional) ---
# Mengambil cuplikan sumber lewat Exa, lalu meminta model bahasa menilai
# setiap klaim HANYA dari cuplikan tersebut. Nonaktif bila kunci kosong.
AI_CLAIM_CHECK_ENABLED=true
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=12
EXA_RESULTS_PER_CLAIM=3
EXA_SNIPPET_CHARS=600
CLAIM_CHECK_MAX_CLAIMS=2
CLAIM_CHECK_MAX_CITATIONS=3

# Model bahasa dengan API kompatibel OpenAI. Contoh base URL:
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://127.0.0.1:11434/v1   (LLM_API_KEY boleh nilai apa pun)
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
# Model reasoning dapat memakai token untuk berpikir; 2048 memberi ruang cukup
# agar JSON per klaim tidak terpotong.
LLM_MAX_TOKENS=2048

# --- Ingest postingan media sosial publik (UnifAPI) ---
# TikTok, Instagram, Facebook, dan X/Twitter membatasi pengambilan halaman
# langsung, sehingga teks/caption, penulis, dan waktu unggah diambil lewat
# UnifAPI. Tanpa kunci, URL media sosial ditolak dan pengguna diminta
# menempelkan teks secara manual.
# Buat kunci di https://api.unifapi.com (Authorization: Bearer <kunci>).
UNIFAPI_API_KEY=
UNIFAPI_BASE_URL=https://api.unifapi.com
SOCIAL_FETCH_TIMEOUT_SECONDS=15
